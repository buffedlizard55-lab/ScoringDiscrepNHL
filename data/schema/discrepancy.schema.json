{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/buffedlizard55-lab/ScoringDiscrepNHL/data/schema/discrepancy.schema.json",
  "title": "NHL scoring discrepancy record",
  "description": "One row of data/discrepancies.json. Enforced in code by pipeline/nhl_scoring/db.py:validate(); this file exists so the contract is reviewable without reading Python. A record always carries BOTH the initial and the corrected state, and every claim carries the official link it came from. Where evidence is missing the field is null and a flag says so - the schema has no field for 'we guessed'.",
  "type": "object",
  "required": ["record_id", "schema_version", "status", "detected_by", "game", "discrepancy",
                "initial_state", "corrected_state", "sources"],
  "additionalProperties": true,
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^SDN-[0-9a-f]{10}$",
      "description": "sha1(game_id|check_id|field|goal_key)[:10]. Derived, not assigned, so re-running detection never mints a duplicate."
    },
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "status": {
      "enum": ["verified", "flagged", "pending_review", "disputed", "retired"],
      "description": "verified = a human/agent read the official artifact and confirmed the states. flagged = detector output needing a read. pending_review = entered from research with gaps still open. disputed = sources irreconcilable. retired = no longer considered real."
    },
    "confidence": { "enum": ["high", "medium", "low"] },
    "detected_by": {
      "enum": ["cross_source", "snapshot_diff", "integrity_check", "manual_research", "prior_art_log"]
    },
    "detection": {
      "type": "object",
      "required": ["check_id", "rule"],
      "properties": {
        "check_id": { "type": "string", "description": "C1..C22 in pipeline/nhl_scoring/checks.py, or MANUAL" },
        "rule": { "type": "string" },
        "rule_label": { "type": "string" },
        "severity": { "enum": ["low", "medium", "high"] },
        "detected_at": { "type": ["string", "null"], "description": "When WE looked. Not a league correction timestamp." },
        "run_id": { "type": ["string", "null"] },
        "tool_version": { "type": ["string", "null"] },
        "when_corrected": { "$ref": "#/definitions/when" }
      }
    },
    "game": {
      "type": "object",
      "required": ["game_id", "season"],
      "properties": {
        "game_id": { "type": ["string", "null"], "pattern": "^[0-9]{10}$",
                     "description": "Official NHL game id (season + gameType + number). Null only on pending records, with the flag game_id_not_resolved." },
        "season": { "type": ["string", "null"], "description": "Season dir, e.g. 20002001" },
        "game_type": { "enum": ["REG", "PO", "ST", "SC", null] },
        "date": { "type": ["string", "null"], "description": "Required for verified and flagged records; enforced in validate()" },
        "away_team": { "type": ["string", "null"] },
        "home_team": { "type": ["string", "null"] },
        "venue": { "type": ["string", "null"] },
        "final_score": { "type": ["object", "null"], "properties": { "away": { "type": ["integer", "null"] }, "home": { "type": ["integer", "null"] } } },
        "gamecenter_url": { "type": ["string", "null"] },
        "report_urls": { "type": "object", "description": "Official report code -> URL, from right-rail gameReports when available" }
      }
    },
    "discrepancy": {
      "type": "object",
      "required": ["change_type", "summary"],
      "properties": {
        "change_type": { "type": "string", "description": "goal_missing_from_one_source, assist_added, scorer_name_conflict, final_score_conflict, ..." },
        "period": { "type": ["integer", "null"], "description": "4 = OT, 5 = SO or 2OT+" },
        "clock": { "type": ["string", "null"], "description": "MM:SS remaining, exactly as printed in the source" },
        "team": { "type": ["string", "null"] },
        "field": { "type": "string" },
        "goal_key": { "type": ["string", "null"], "description": "period|clock_seconds|team - the join key" },
        "summary": { "type": "string" },
        "detail": { "type": ["string", "null"] },
        "total_changed": { "type": ["boolean", "null"], "description": "true/false only when the two states prove it; null means not established, and the record is bucketed with the other unknowns" },
        "attribution_only": { "type": ["boolean", "null"] },
        "goal_no_goal_change": { "type": "boolean" },
        "video_review": { "type": "boolean" },
        "when_corrected": { "$ref": "#/definitions/when" },
        "timing_uncertain": { "type": "boolean", "description": "true when we only know a report stamp, not the moment of correction" },
        "reason": {
          "type": "object",
          "properties": {
            "stated_by_league": { "type": "boolean" },
            "text": { "type": "string" },
            "rule_citation": { "type": ["string", "null"] },
            "needs_human_read": { "type": "boolean" }
          }
        },
        "market_impact": {
          "type": "object",
          "description": "Settlement exposure flag: which class of outcome the discrepancy could move. Tri-state on purpose.",
          "properties": {
            "total_changed": { "type": ["boolean", "null"] },
            "affects_game_total": { "$ref": "#/definitions/tri" },
            "affects_period_total": { "$ref": "#/definitions/tri" },
            "affects_player_props": { "$ref": "#/definitions/tri" },
            "affects_result_markets": { "$ref": "#/definitions/tri" },
            "risk": { "enum": ["none", "low", "medium", "high"] },
            "reason": { "type": "string" },
            "rule_class": { "enum": ["total", "attribution", "timing", "unknown"] }
          }
        }
      }
    },
    "initial_state": { "$ref": "#/definitions/state" },
    "corrected_state": { "$ref": "#/definitions/state" },
    "totals": {
      "type": "object",
      "properties": {
        "initial_game_goals": { "type": ["integer", "null"] },
        "corrected_game_goals": { "type": ["integer", "null"] },
        "goal_delta": { "type": ["integer", "null"] },
        "basis": { "type": "string", "description": "How the numbers were derived, e.g. 'goal rows counted per artifact'" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "Mandatory. A record without an https official link cannot be verified.",
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://" },
          "kind": { "enum": ["official_report", "official_api", "official_page", "official_document", "snapshot", "third_party", "secondary", "internal", null] },
          "evidence": { "enum": ["primary", "secondary", "reference", "none"] },
          "retrieved_at": { "type": ["string", "null"] },
          "sha256": { "type": ["string", "null"] },
          "http_status": { "type": ["integer", "null"] },
          "quote": { "type": ["string", "null"], "description": "Verbatim text or JSON fragment the claim rests on" },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "evidence_grade": { "enum": ["primary", "secondary", "none", null] },
        "independently_checkable": { "type": "boolean" },
        "check_instructions": { "type": "string" },
        "verified_by": { "type": "string" },
        "verified_at": { "type": "string", "description": "Required by validate() when status is verified" },
        "residual_uncertainty": { "type": ["string", "null"] }
      }
    },
    "flags": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  },
  "definitions": {
    "when": {
      "enum": ["in_game", "intermission", "postgame", "next_day", "unknown", "not_applicable"],
      "description": "When the correction took effect, as far as the evidence allows. 'unknown' is a real answer here, not a placeholder."
    },
    "tri": { "enum": ["yes", "no", "possible", "unknown"] },
    "state": {
      "type": "object",
      "description": "One side of the comparison. Presence is a ruling too: a goal absent from an artifact is recorded with goal_present=false and ruling='not_recorded_by_this_artifact' rather than being asserted as 'no goal'.",
      "properties": {
        "artifact": { "type": ["string", "null"] },
        "goal_present": { "type": ["boolean", "null"] },
        "ruling": { "type": ["string", "null"] },
        "scorer": { "type": ["object", "null"], "properties": { "key": { "type": ["string", "null"] }, "name": { "type": "string" }, "player_id": { "type": ["integer", "string", "null"] }, "number": { "type": ["integer", "null"] }, "goals_to_date": { "type": ["integer", "null"] } } },
        "assists": { "type": "array", "items": { "type": "object" } },
        "period": { "type": ["integer", "null"] },
        "clock": { "type": ["string", "null"] },
        "team": { "type": ["string", "null"] },
        "strength": { "type": ["string", "null"] },
        "strength_raw": { "type": ["string", "null"] },
        "own_goal": { "type": ["boolean", "null"] },
        "empty_net": { "type": ["boolean", "null"] },
        "shot_type": { "type": ["string", "null"] },
        "score_after": { "type": ["object", "null"], "properties": { "away": { "type": ["integer", "null"] }, "home": { "type": ["integer", "null"] } } },
        "goalkeeper": { "type": ["object", "null"] }
      }
    }
  }
}
