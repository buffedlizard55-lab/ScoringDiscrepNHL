# Python
__pycache__/
*.py[cod]
*.pyc
*.egg-info/
.venv/
venv/
.pytest_cache/

# Local caches and build output that must never be committed
.cache/
site_build/
_sitecheck*/
# build output of tools/build_site.py (published as a Pages artifact, never committed)
_site/

# Official-feed snapshot cache: a stale cache must never masquerade as a fresh official record
data/snapshots/

# Generated CSV exports are regenerated by the export command, not curated content
data/exports/*.csv

# Local scratch
*.tmp
.DS_Store
*.swp

# Never lose the workflows themselves
!.github/workflows/*.yml
