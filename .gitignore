# build output of tools/build_site.py (published as a Pages artifact, never committed)
_site/

# optional HTTP cache used by the collector (never commit: a stale cache must not
# masquerade as a fresh official record)
.cache/

# local scratch
*.tmp
__pycache__/
*.pyc
.pytest_cache/

# tooling config files may reference the monitoring cadence; do not lose them
!.github/workflows/*.yml

# generated CSV exports are regenerated by the backfill workflow, not committed
data/exports/*.csv
